{
  "name": "itchypet-vet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src *.json *.js *.ts",
    "format:check": "prettier --check src *.json *.js *.ts"
  },
  "devDependencies": {
    "svelte": "5.58.0",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "vite": "7.3.8",
    "daisyui": "5.8.1",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "3.5.2",
    "@types/node": "22.20.5",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/noto-serif": "5.3.0"
  }
}
