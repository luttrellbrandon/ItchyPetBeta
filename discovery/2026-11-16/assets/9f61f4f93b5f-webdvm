<script>

    //Implementation of reCaptcha v2 Invisible

    var initRecaptcha = function(){

        if ( document.getElementById("form-recaptch") ) {

            recaptcha = grecaptcha.render("form-recaptch", {
                'sitekey' : '6Lda8psUAAAAAEAQAjqgE33quOXIEuiINP0PHO00',
                'theme'    : 'light',
                'badge'    : 'bottomleft',
                'size'     : 'invisible',
                'callback' : recaptchaFormsAjax
            });
        }
    };

    var recaptchaFormsAjax = function(){

        var container = $("#form-recaptch").parents("form");

        $.ajax({
            url: "/recaptcha", // Validate the recaptcha challenge
            method: "POST",
            dataType:'json',
            data: container.serialize(),
            beforeSend: function(xhr) {
                ll_script.transition("quote_loading_results");
            },
            success: function(responseObj){

                // Show error message - from AjaxController.recaptcha
                if ( responseObj.result == "success" ) {

                    //ensure no challenge if user uses Go Back button
                    ll_script.captcha_passed = true;

                    // Now OK to submit form
                    var form = $('#owner_pet_details');
                    form.submit();

                    //continue without waiting for save result
                    ll_script.initSelectProvider();

                } else if( responseObj.result == "notlegit" ) {

                    //recaptcha detected bot attempt
                    container.find('.captcha-validation-errors').html(responseObj.info).stop(0,0).slideDown(500,function(){
                        $(this).css('height','auto');
                    });

                } else {
                    // Show error message - from AjaxController.recaptcha
                    console.log("recaptcha validation error responseObj.msg = " + responseObj.msg)
                    container.find('.validation-errors').html(responseObj.msg).stop(0,0).slideDown(500,function(){
                        $(this).css('height','auto');
                    });
                }
            }
        });
    }

